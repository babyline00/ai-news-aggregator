# Database (SQLite) — must be an absolute file path.
# The package.json db:* scripts inline this as:
#   DATABASE_URL="$(pwd)/db/custom.db"
# You can override it here for local dev.
DATABASE_URL="file:/home/z/my-project/apps/60-ai-news-aggregator/db/custom.db"

# --- LLM (optional) --------------------------------------------------------
# The headline rewriter uses the z-ai-web-dev-sdk when available.
# Set PKC_DISABLE_LLM=1 to force the pure-function fallbackRewrite path
# (useful for offline dev / CI / deterministic tests).
PKC_DISABLE_LLM=
